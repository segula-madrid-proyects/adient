<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kiosko - Dashboard</title>
    <link rel="stylesheet" href="/css/global.css">
   <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
    <div class="header">
        <h1>🏢 Kiosko Corporativo</h1>
        <a href="/logout" class="logout-btn">🚪 Cerrar Sesión</a>
    </div>
    
    <div class="container">
        <div class="welcome-card">
            <h2>¡Bienvenido, <%= user.displayName || user.email %>! 👋</h2>
            <p class="subtitle">Has iniciado sesión correctamente mediante SAML 2.0</p>
            <span class="success-badge">✅ Autenticación exitosa</span>
        </div>
        
        <div class="user-info">
            <h3>📋 Información del Usuario</h3>
            
            <div class="info-row">
                <div class="info-label">ID de Usuario:</div>
                <div class="info-value"><%= user.id %></div>
            </div>
            
            <div class="info-row">
                <div class="info-label">Email:</div>
                <div class="info-value"><%= user.email || 'No disponible' %></div>
            </div>
            
            <div class="info-row">
                <div class="info-label">Nombre completo:</div>
                <div class="info-value"><%= user.displayName || 'No disponible' %></div>
            </div>
            
            <% if (user.firstName) { %>
            <div class="info-row">
                <div class="info-label">Nombre:</div>
                <div class="info-value"><%= user.firstName %></div>
            </div>
            <% } %>
            
            <% if (user.lastName) { %>
            <div class="info-row">
                <div class="info-label">Apellido:</div>
                <div class="info-value"><%= user.lastName %></div>
            </div>
            <% } %>
            
            <div class="auto-logout-warning">
                ⚠️ <strong>Importante para Kiosko:</strong> Por seguridad, la sesión se cerrará automáticamente tras 5 minutos de inactividad.
            </div>
            
            <div class="session-timer">
                Tiempo restante de sesión: <span id="countdown">5:00</span>
            </div>
        </div>
    </div>
    
    <script src="/js/deshboard.js"></script>
</body>
</html>